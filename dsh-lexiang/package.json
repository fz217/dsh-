{
  "name": "dsh-lexiang",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin for browsing and searching Lexiang knowledge bases, with knowledge management tools.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./ui": "./src/ui.js",
    "./package.json": "./package.json",
    "./mcp-client": "./src/mcp-client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "selftest.mjs",
    "client.js",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lexiang",
    "knowledge-base",
    "mcp",
    "ui",
    "popup"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
