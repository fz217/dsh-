{
  "name": "dsh-lexiang",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin for browsing and searching Lexiang knowledge bases, with knowledge management tools.",
  "main": "./dsh-lexiang/index.js",
  "files": [
    "dsh-lexiang"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lexiang",
    "knowledge-base",
    "mcp",
    "ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-lexiang/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT",
  "exports": {
    ".": "./dsh-lexiang/index.js",
    "./client": "./dsh-lexiang/client.js",
    "./mcp-client": "./dsh-lexiang/src/mcp-client.js",
    "./icon": "./dsh-lexiang/icon.svg",
    "./package.json": "./package.json"
  }
}
